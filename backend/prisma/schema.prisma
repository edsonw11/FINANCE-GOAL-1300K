// Everfox database schema (ADR-0004): PostgreSQL, money as BIGINT cents, a user_id on every row.
// The connection URL is not here: Prisma 7 reads it from prisma.config.ts (DATABASE_URL).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// The owner of every other row. A person is the pair (issuer, subject) of the identity provider: never the e-mail,
// which can be changed or reused, so matching on it could hand one person's data to another.
model AppUser {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  oidcIssuer  String   @map("oidc_issuer")
  oidcSubject String   @map("oidc_subject")
  email       String?
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt DateTime @default(now()) @map("last_login_at") @db.Timestamptz(6)
  planId      String   @default("free") @map("plan_id")
  isAdmin     Boolean  @default(false) @map("is_admin")

  sessions     Session[]
  records      Record[]
  userState    UserState?
  syncCursor   SyncCursor?
  syncMutation SyncMutation[]
  plan         Plan           @relation(fields: [planId], references: [id])
  auditLogs    AuditLog[]

  @@unique([oidcIssuer, oidcSubject])
  @@index([planId])
  @@map("app_user")
}

// A login. The browser holds a random value; only its SHA-256 is stored, so a copy of this table cannot be used to log in.
model Session {
  idHash     String   @id @map("id_hash")
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

// One login attempt in progress (state, nonce, PKCE verifier). Used once: it is deleted when the provider sends the user back.
model AuthFlow {
  idHash       String   @id @map("id_hash")
  state        String
  nonce        String
  codeVerifier String   @map("code_verifier")
  returnTo     String   @map("return_to")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("auth_flow")
}

// Everything a person records: accounts, transactions, balances, trades, transfers, imports (one `kind` each). The id is chosen by the
// device (ADR-0008); `body` keeps the shape the browser app uses (ADR-0011); a delete leaves a tombstone so it reaches every device.
model Record {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  legacyKey String?   @map("legacy_key")
  position  BigInt
  body      Json
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   BigInt

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, version])
  @@index([userId, kind, position])
  @@map("record")
}

// The person's settings, categories and groups as one document (goal, rate, card, budgets, ...).
model UserState {
  userId    String   @id @map("user_id") @db.Uuid
  body      Json
  version   BigInt
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_state")
}

// The last version handed out to a person. Writers lock the row, so the versions of one person come out, and commit, in order.
model SyncCursor {
  userId      String @id @map("user_id") @db.Uuid
  lastVersion BigInt @map("last_version")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sync_cursor")
}

// A mutation a device sent and the answer it got: sending it again returns the same answer and changes nothing.
model SyncMutation {
  userId     String   @map("user_id") @db.Uuid
  mutationId String   @map("mutation_id") @db.Uuid
  outcome    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mutationId])
  @@index([createdAt])
  @@map("sync_mutation")
}

// A plan a person can be on. Which features it has is in plan_feature; the catalogue of keys is in code (src/plans/features.ts).
model Plan {
  id       String        @id
  name     String
  features PlanFeature[]
  users    AppUser[]

  @@map("plan")
}

model PlanFeature {
  planId     String @map("plan_id")
  featureKey String @map("feature_key")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([planId, featureKey])
  @@map("plan_feature")
}

// Changes made through the admin routes: who, what, on what, when.
model AuditLog {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  target      String
  details     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor AppUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_log")
}
