# Local development only. Copy to .env (git ignores it): cp .env.example .env
# The password below is the one the local docker compose database starts with. The API refuses it in production.
DATABASE_URL=postgresql://everfox:everfox_dev_only@127.0.0.1:5433/everfox
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
HEALTH_CHECK_TIMEOUT_MS=2000
# Login (OpenID Connect). These match the Keycloak of docker compose (dev/keycloak/everfox-realm.json).
APP_BASE_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:8081/realms/everfox
OIDC_CLIENT_ID=everfox-web
OIDC_CLIENT_SECRET=everfox-dev-client-secret

# Multiplies the request limits (login, sync, import). Leave at 1: a larger value is refused in production.
# Only raise it in local scripts or tests that do far more than a person does.
# RATE_LIMIT_FACTOR=1
