<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Everfox: API and Use Cases"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: API and Use Cases&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Every route except the ones marked public needs a login. Writes also need the app's origin and the CSRF header. Unless said otherwise the errors are 400 (input), 401, 403, 429.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="70" as="geometry"/></mxCell><mxCell id="p1_l_pub" value="Pages, health and login" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="1101" as="geometry"/></mxCell><mxCell id="p1_n_ep-web" value="&lt;b&gt;GET /, /index.html, /src/*, /vendor/*&lt;/b&gt;&lt;br&gt;Serves the browser app from an allow-list of files (public, no rate limit). 404 for anything else.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/web/web.controller.ts &amp;gt; WebController&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_pub"><mxGeometry x="20" y="56" width="260" height="151" as="geometry"/></mxCell><mxCell id="p1_n_ep-live" value="&lt;b&gt;GET /health/live&lt;/b&gt;&lt;br&gt;The process is up (public).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/health/health.controller.ts &amp;gt; live&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_pub"><mxGeometry x="20" y="227" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_n_ep-ready" value="&lt;b&gt;GET /health/ready&lt;/b&gt;&lt;br&gt;The database answers within the timeout (public). Not ready otherwise.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/health/health.controller.ts &amp;gt; ready&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_pub"><mxGeometry x="20" y="354" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_ep-login" value="&lt;b&gt;GET /auth/login?returnTo&lt;/b&gt;&lt;br&gt;Starts the OIDC login; 302 to the provider. Public, 20 per minute per address. 503 when the provider is unreachable.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/auth.controller.ts &amp;gt; start&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_pub"><mxGeometry x="20" y="495" width="260" height="149" as="geometry"/></mxCell><mxCell id="p1_n_ep-cb" value="&lt;b&gt;GET /auth/callback&lt;/b&gt;&lt;br&gt;Finishes the login; session cookie; 302 to returnTo, or to the login-failed page. Public, 20 per minute per address.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/auth.controller.ts &amp;gt; finish&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_pub"><mxGeometry x="20" y="664" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_ep-out" value="&lt;b&gt;POST /auth/logout&lt;/b&gt;&lt;br&gt;Ends the session; answers the provider's end-session address or null. Public.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/auth.controller.ts &amp;gt; logout&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_pub"><mxGeometry x="20" y="819" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_ep-me" value="&lt;b&gt;GET /api/v1/me&lt;/b&gt;&lt;br&gt;Who is logged in, with the plan features (the app shows locked ones as PRO).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/me.controller.ts &amp;gt; MeController&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_pub"><mxGeometry x="20" y="960" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_l_data" value="A person's data" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="1232" as="geometry"/></mxCell><mxCell id="p1_n_ep-push" value="&lt;b&gt;POST /api/v1/sync/push&lt;/b&gt;&lt;br&gt;Applies the outbox in order. Body: mutations (mutationId, resource, id, op, data). Answer: one result per mutation (applied, superseded, rejected, skipped). 120 per minute per person.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/sync/sync.controller.ts &amp;gt; push&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="56" width="260" height="163" as="geometry"/></mxCell><mxCell id="p1_n_ep-chg" value="&lt;b&gt;GET /api/v1/sync/changes&lt;/b&gt;&lt;br&gt;Changes after a cursor, in version order. Query: cursor, limit. Answer: changes, cursor, hasMore.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/sync/sync.controller.ts &amp;gt; changes&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="239" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_ep-al" value="&lt;b&gt;GET /api/v1/accounts&lt;/b&gt;&lt;br&gt;The person's accounts: { items }.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/accounts/accounts.controller.ts &amp;gt; list&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="394" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_n_ep-ag" value="&lt;b&gt;GET /api/v1/accounts/:id&lt;/b&gt;&lt;br&gt;One account. 404 when it is not found.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/accounts/accounts.controller.ts &amp;gt; get&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="521" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_n_ep-ap" value="&lt;b&gt;PUT /api/v1/accounts/:id&lt;/b&gt;&lt;br&gt;Creates or renames an account (idempotent). Body: name.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/accounts/accounts.controller.ts &amp;gt; save&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="648" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_ep-ad" value="&lt;b&gt;DELETE /api/v1/accounts/:id&lt;/b&gt;&lt;br&gt;Removes an account (204).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/accounts/accounts.controller.ts &amp;gt; remove&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="789" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_n_ep-imp" value="&lt;b&gt;POST /api/v1/import/ legacy-state?replace&lt;/b&gt;&lt;br&gt;Imports a whole state (up to 25 MB). 6 per hour per person.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/legacy/legacy.controller.ts &amp;gt; importState&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="916" width="260" height="153" as="geometry"/></mxCell><mxCell id="p1_n_ep-exp" value="&lt;b&gt;GET /api/v1/export/legacy-state&lt;/b&gt;&lt;br&gt;Exports the whole state.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/legacy/legacy.controller.ts &amp;gt; exportState&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="1089" width="260" height="123" as="geometry"/></mxCell><mxCell id="p1_l_rules" value="Month rules and admin" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="1201" as="geometry"/></mxCell><mxCell id="p1_n_ep-sum" value="&lt;b&gt;GET /api/v1/months/:month/summary&lt;/b&gt;&lt;br&gt;Month summary computed by the shared rules. :month is yyyy-mm.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/legacy/months.controller.ts &amp;gt; summary&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_rules"><mxGeometry x="20" y="56" width="260" height="137" as="geometry"/></mxCell><mxCell id="p1_n_ep-res" value="&lt;b&gt;GET /api/v1/months/:month/result&lt;/b&gt;&lt;br&gt;Month result: income, expenses, left, rate, level.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/legacy/months.controller.ts &amp;gt; result&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_rules"><mxGeometry x="20" y="213" width="260" height="137" as="geometry"/></mxCell><mxCell id="p1_n_ep-rep" value="&lt;b&gt;GET /api/v1/months/:month/report&lt;/b&gt;&lt;br&gt;Monthly report data. Needs plan feature report.monthly (403 feature_locked). Optional today=yyyy-mm-dd.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/legacy/months.controller.ts &amp;gt; report&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_rules"><mxGeometry x="20" y="370" width="260" height="151" as="geometry"/></mxCell><mxCell id="p1_n_ep-apl" value="&lt;b&gt;GET /api/v1/admin/plans&lt;/b&gt;&lt;br&gt;Plans and their features. Admin only.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/admin.controller.ts &amp;gt; list&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_rules"><mxGeometry x="20" y="541" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_n_ep-aen" value="&lt;b&gt;PUT /api/v1/admin/plans/:planId/ features/:key&lt;/b&gt;&lt;br&gt;Turns a feature on for a plan (key must be in the catalogue; 400 unknown_feature). Written to the audit log.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/admin.controller.ts &amp;gt; enable&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_rules"><mxGeometry x="20" y="668" width="260" height="181" as="geometry"/></mxCell><mxCell id="p1_n_ep-adi" value="&lt;b&gt;DELETE /api/v1/admin/plans/:planId/ features/:key&lt;/b&gt;&lt;br&gt;Turns a feature off. Audit logged.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/admin.controller.ts &amp;gt; disable&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_rules"><mxGeometry x="20" y="869" width="260" height="139" as="geometry"/></mxCell><mxCell id="p1_n_ep-aus" value="&lt;b&gt;PUT /api/v1/admin/users/:userId/ plan&lt;/b&gt;&lt;br&gt;Moves a person to a plan. 404 when the person is not found. Audit logged.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/admin.controller.ts &amp;gt; setPlan&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_rules"><mxGeometry x="20" y="1028" width="260" height="153" as="geometry"/></mxCell><mxCell id="p1_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="1352" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="180" y="1352" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="340" y="1352" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1386" width="1080" height="28" as="geometry"/></mxCell><mxCell id="p1_note0" value="The rows of this diagram are generated into analysis/api-catalog.md too. A route is never listed unless it is a decorated method of a controller." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1418" width="1080" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
