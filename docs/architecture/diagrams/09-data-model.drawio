<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="On the device"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1055" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Data Kept on the Device&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;No database in the browser: one JSON in localStorage (key metaapp.v2, version 2), plus small side keys.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="860" height="70" as="geometry"/></mxCell><mxCell id="p1_l_state" value="State S (metaapp.v2)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="865" as="geometry"/></mxCell><mxCell id="p1_n_m-root" value="&lt;b&gt;Root&lt;/b&gt;&lt;br&gt;v (2), goal, rate, planned, nid (next id), ownNames, card settings.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/store.js &amp;gt; blankState&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_state"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_m-acc" value="&lt;b&gt;accounts&lt;/b&gt;&lt;br&gt;id, name, archived, reserve, kind; balances come from snaps.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/accounts.js &amp;gt; balance&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_state"><mxGeometry x="20" y="184" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_m-snap" value="&lt;b&gt;snaps&lt;/b&gt;&lt;br&gt;date, acc, value, est: a dated balance of an account.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/store.js &amp;gt; snaps&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_state"><mxGeometry x="20" y="312" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_m-tx" value="&lt;b&gt;tx&lt;/b&gt;&lt;br&gt;id, type (receita, despesa, aporte, fatura...), value, date, cat, fonte, desc, acc, splits, fm.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/transaction-builder.js &amp;gt; saveTransaction&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_state"><mxGeometry x="20" y="440" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_m-trade" value="&lt;b&gt;trades&lt;/b&gt;&lt;br&gt;ticker, side (C or V), qty, price, fees, date, cls.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/portfolio.js &amp;gt; tradesOf&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_state"><mxGeometry x="20" y="595" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_m-xfer" value="&lt;b&gt;transfers and imports&lt;/b&gt;&lt;br&gt;Own-account transfers kept apart, and the keys of imported items (to find duplicates).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/transfers.js &amp;gt; transfers&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_state"><mxGeometry x="20" y="723" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_l_side" value="Side keys" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="566" as="geometry"/></mxCell><mxCell id="p1_n_k-bak" value="&lt;b&gt;metaapp.v2.bak and .broken&lt;/b&gt;&lt;br&gt;The previous good copy (once a day), and the copy of data that could not be read.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/state-recovery.js &amp;gt; BACKUP_SUFFIX&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_side"><mxGeometry x="20" y="56" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_k-sync" value="&lt;b&gt;Sync bookkeeping&lt;/b&gt;&lt;br&gt;cursor, outbox, review list, fingerprints, one key next to the state.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/outbox.js &amp;gt; emptyMeta&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_side"><mxGeometry x="20" y="197" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_k-lock" value="&lt;b&gt;metaapp.lock&lt;/b&gt;&lt;br&gt;The app lock flag (&amp;quot;1&amp;quot; when on).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/app-lock/lock-policy.js &amp;gt; LOCK_KEY&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_side"><mxGeometry x="20" y="325" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_n_k-last" value="&lt;b&gt;metaapp.lastBackup&lt;/b&gt;&lt;br&gt;When a backup last left the device.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/backup.js &amp;gt; LAST_BACKUP_KEY&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_side"><mxGeometry x="20" y="452" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_e0" value="has many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_m-root" target="p1_n_m-acc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e1" value="has many" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_m-acc" target="p1_n_m-snap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="copy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_m-root" target="p1_n_k-bak"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="20" y="985" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="180" y="985" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1019" width="860" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p2" name="In PostgreSQL"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1355" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Tables of the API Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;backend/prisma/schema.prisma. A person's data is records of a kind with a version; ids are UUID v7 where the database creates them.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="860" height="70" as="geometry"/></mxCell><mxCell id="p2_l_id" value="Identity and sessions" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="507" as="geometry"/></mxCell><mxCell id="p2_n_t-user" value="&lt;b&gt;app_user&lt;/b&gt;&lt;br&gt;id, oidc_issuer + oidc_subject (unique), email, display_name, plan_id, is_admin, last_login_at.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model AppUser&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p2_l_id"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p2_n_t-sess" value="&lt;b&gt;session&lt;/b&gt;&lt;br&gt;id_hash (the cookie value is never stored), user_id, last_seen_at, expires_at.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model Session&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p2_l_id"><mxGeometry x="20" y="211" width="260" height="135" as="geometry"/></mxCell><mxCell id="p2_n_t-flow" value="&lt;b&gt;auth_flow&lt;/b&gt;&lt;br&gt;One login attempt: state, nonce, code_verifier, return_to, expires_at.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model AuthFlow&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p2_l_id"><mxGeometry x="20" y="366" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_l_data" value="A person's data" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="634" as="geometry"/></mxCell><mxCell id="p2_n_t-rec" value="&lt;b&gt;record&lt;/b&gt;&lt;br&gt;id, user_id, kind (account, tx, snap, trade, transfer, import), position, body (JSON), version, deleted_at.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model Record&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p2_l_data"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p2_n_t-state" value="&lt;b&gt;user_state&lt;/b&gt;&lt;br&gt;The settings part of the state as one JSON, with a version.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model UserState&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p2_l_data"><mxGeometry x="20" y="211" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_t-cur" value="&lt;b&gt;sync_cursor&lt;/b&gt;&lt;br&gt;last_version: the person's change counter.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model SyncCursor&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p2_l_data"><mxGeometry x="20" y="352" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_t-mut" value="&lt;b&gt;sync_mutation&lt;/b&gt;&lt;br&gt;(user_id, mutation_id) and its outcome: a retry gets the first answer.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model SyncMutation&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p2_l_data"><mxGeometry x="20" y="493" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_l_plan" value="Plans" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="778" width="300" height="465" as="geometry"/></mxCell><mxCell id="p2_n_t-plan" value="&lt;b&gt;plan&lt;/b&gt;&lt;br&gt;id, name.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model Plan&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p2_l_plan"><mxGeometry x="20" y="56" width="260" height="107" as="geometry"/></mxCell><mxCell id="p2_n_t-feat" value="&lt;b&gt;plan_feature&lt;/b&gt;&lt;br&gt;(plan_id, feature_key): what each plan can use.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model PlanFeature&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p2_l_plan"><mxGeometry x="20" y="183" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_t-audit" value="&lt;b&gt;audit_log&lt;/b&gt;&lt;br&gt;actor, action, target, details of admin changes.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model AuditLog&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p2_l_plan"><mxGeometry x="20" y="324" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_e0" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_t-user" target="p2_n_t-rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e1" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_n_t-user" target="p2_n_t-sess"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e2" value="on a plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_t-user" target="p2_n_t-plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e3" value="has" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_n_t-plan" target="p2_n_t-feat"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_lg0" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="20" y="1267" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg1" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="180" y="1267" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg2" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="340" y="1267" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1301" width="860" height="28" as="geometry"/></mxCell><mxCell id="p2_note0" value="Records use an index on (user_id, version) for the changes after a cursor. The API database role only reads and writes data; migrations run with another role (backend/prisma/roles/grants.sql)." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1333" width="860" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
