<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="In the browser"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="628" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Pipeline of the Monthly Report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Built in the page from the state; the PDF is made by the browser's own print dialog (Save as PDF). The same data can be asked of the API (second page).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="p1_l_s1" value="1. Ask" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="311" as="geometry"/></mxCell><mxCell id="p1_n_r-btn" value="&lt;b&gt;Print button&lt;/b&gt;&lt;br&gt;The person prints the month on screen.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/settings.js &amp;gt; bindSettings&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_s1"><mxGeometry x="20" y="56" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_n_r-mail" value="&lt;b&gt;E-mail button&lt;/b&gt;&lt;br&gt;Opens the mail program with a subject and a short text.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/report-print.js &amp;gt; reportMailUrl&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_s1"><mxGeometry x="20" y="170" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_l_s2" value="2. Compute" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="198" as="geometry"/></mxCell><mxCell id="p1_n_r-build" value="&lt;b&gt;buildReport&lt;/b&gt;&lt;br&gt;Every number of the report in one place: month result, last 6 months, biggest groups and expenses, goal.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/report.js &amp;gt; buildReport&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_s2"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_l_s3" value="3. Write the content" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="438" as="geometry"/></mxCell><mxCell id="p1_n_r-html" value="&lt;b&gt;reportHtml&lt;/b&gt;&lt;br&gt;The page of the report in plain language.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/report-html.js &amp;gt; reportHtml&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_s3"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_r-fill" value="&lt;b&gt;renderReport&lt;/b&gt;&lt;br&gt;Fills the print-only box of the page.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/report-print.js &amp;gt; renderReport&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_s3"><mxGeometry x="20" y="184" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_n_r-text" value="&lt;b&gt;reportText&lt;/b&gt;&lt;br&gt;The short text for the e-mail.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/report-text.js &amp;gt; reportMailUrl&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_s3"><mxGeometry x="20" y="311" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_l_s4" value="4. Deliver" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1190" y="96" width="300" height="325" as="geometry"/></mxCell><mxCell id="p1_n_r-css" value="&lt;b&gt;Print styles&lt;/b&gt;&lt;br&gt;Only the report is shown when printing.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/styles/10-print.css&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p1_l_s4"><mxGeometry x="20" y="56" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_n_r-pdf" value="&lt;b&gt;Browser print dialog&lt;/b&gt;&lt;br&gt;The person saves it as a PDF or prints it. The app does not write a PDF file itself.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/report-print.js &amp;gt; renderReport&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p1_l_s4"><mxGeometry x="20" y="170" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_r-btn" target="p1_n_r-build"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_r-mail" target="p1_n_r-build"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_r-build" target="p1_n_r-html"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_r-html" target="p1_n_r-fill"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e4" value="e-mail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_r-build" target="p1_n_r-text"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_r-fill" target="p1_n_r-css"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_r-css" target="p1_n_r-pdf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="558" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="180" y="558" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="340" y="558" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg3" value="Results and outputs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="1"><mxGeometry x="500" y="558" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="592" width="1400" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p2" name="On the API"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="417" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Monthly Report on the API (Pro)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;JSON only. A Pro feature: a person on a plan without report.monthly gets 403 feature_locked.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="p2_l_s1" value="1. Request" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="227" as="geometry"/></mxCell><mxCell id="p2_n_q-route" value="&lt;b&gt;GET /api/v1/months/:month/report&lt;/b&gt;&lt;br&gt;Month as yyyy-mm; optional today=yyyy-mm-dd for a person whose day differs from the server's.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/legacy/months.controller.ts &amp;gt; report&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p2_l_s1"><mxGeometry x="20" y="56" width="260" height="151" as="geometry"/></mxCell><mxCell id="p2_l_s2" value="2. Check" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="197" as="geometry"/></mxCell><mxCell id="p2_n_q-guard" value="&lt;b&gt;FeatureGuard&lt;/b&gt;&lt;br&gt;The plan must have report.monthly, read from the database on every call.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/guards.ts &amp;gt; FeatureGuard&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=30;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="p2_l_s2"><mxGeometry x="20" y="56" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_l_s3" value="3. Compute" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="211" as="geometry"/></mxCell><mxCell id="p2_n_q-rules" value="&lt;b&gt;FinanceRulesService.compute&lt;/b&gt;&lt;br&gt;Loads the stored state, completes it from the blank state, runs the shared buildReport. Nothing is saved.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/legacy/finance-rules.service.ts &amp;gt; compute&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p2_l_s3"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p2_l_s4" value="4. Answer" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1190" y="96" width="300" height="184" as="geometry"/></mxCell><mxCell id="p2_n_q-json" value="&lt;b&gt;Report data (JSON)&lt;/b&gt;&lt;br&gt;The same numbers the page prints; no file is generated.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/report.js &amp;gt; buildReport&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p2_l_s4"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p2_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_q-route" target="p2_n_q-guard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e1" value="allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_q-guard" target="p2_n_q-rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_q-rules" target="p2_n_q-json"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="347" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg1" value="Decisions and validations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="180" y="347" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg2" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="340" y="347" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg3" value="Results and outputs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="1"><mxGeometry x="500" y="347" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="381" width="1400" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
