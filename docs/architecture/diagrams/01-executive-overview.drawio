<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Everfox: System Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1317" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: System Overview&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Personal finance app: follow a net-worth goal (default R$ 1,300,000), monthly cash flow, credit card invoices and investments. Works offline in the browser and in an Android app; cloud sync is optional (web only).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="70" as="geometry"/></mxCell><mxCell id="p1_l_in" value="1. Inputs" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="480" as="geometry"/></mxCell><mxCell id="p1_n_in-manual" value="&lt;b&gt;Manual entry&lt;/b&gt;&lt;br&gt;The + button form, or one short Portuguese sentence such as &amp;quot;Gastei 85,90 no mercado hoje&amp;quot;.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/quick-entry.js &amp;gt; parseQuickEntry&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_in"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_in-import" value="&lt;b&gt;Bank files&lt;/b&gt;&lt;br&gt;OFX, CSV and digital PDF (statements and card invoices); B3 brokerage notes.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/import-reader.js &amp;gt; readImportFile&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_in"><mxGeometry x="20" y="211" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_in-backup" value="&lt;b&gt;Backup file&lt;/b&gt;&lt;br&gt;A JSON file exported earlier is restored.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/backup.js &amp;gt; bindBackup&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_in"><mxGeometry x="20" y="352" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_l_app" value="2. Everfox app (on the device)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="340" as="geometry"/></mxCell><mxCell id="p1_n_app-rules" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;Month result, card invoices, goal projection, portfolio, budgets, emergency reserve.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/month-result.js &amp;gt; monthResult&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_app"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_app-state" value="&lt;b&gt;Local state&lt;/b&gt;&lt;br&gt;One JSON in the browser storage (key metaapp.v2) with an automatic copy of the previous day.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/store.js &amp;gt; transact&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_app"><mxGeometry x="20" y="198" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_l_out" value="3. Outputs" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="622" as="geometry"/></mxCell><mxCell id="p1_n_out-screens" value="&lt;b&gt;Screens&lt;/b&gt;&lt;br&gt;Numbers, charts and lists: Summary, Lançamentos, Cartão, Patrimônio, Análise, Categorias, Ajustes.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/render.js &amp;gt; render&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p1_l_out"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_out-report" value="&lt;b&gt;Monthly report&lt;/b&gt;&lt;br&gt;Printed or saved as PDF by the browser, or sent as an e-mail summary.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/report-print.js &amp;gt; renderReport&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p1_l_out"><mxGeometry x="20" y="198" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_out-backup" value="&lt;b&gt;Backup file&lt;/b&gt;&lt;br&gt;JSON saved by the browser, or shared through the Android share sheet.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/native-bridge.js &amp;gt; shareTextFile&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p1_l_out"><mxGeometry x="20" y="339" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_out-apk" value="&lt;b&gt;Android app&lt;/b&gt;&lt;br&gt;The same app inside a Capacitor shell: offline, with an app lock (fingerprint or phone PIN).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;android/app/src/main/java/com/everfox/app/MainActivity.java &amp;gt; MainActivity&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p1_l_out"><mxGeometry x="20" y="467" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_l_cloud" value="Optional cloud (web app only)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="766" width="300" height="439" as="geometry"/></mxCell><mxCell id="p1_n_cl-sync" value="&lt;b&gt;Sync client&lt;/b&gt;&lt;br&gt;Sends what changed offline, then pulls what changed elsewhere.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/runner.js &amp;gt; createSync&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_cloud"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_cl-api" value="&lt;b&gt;API (NestJS)&lt;/b&gt;&lt;br&gt;Login, sync, accounts, month rules, plans.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/create-app.ts &amp;gt; createApp&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_cloud"><mxGeometry x="20" y="184" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_cl-db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Records, user state, sessions, plans.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model Record&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_cloud"><mxGeometry x="20" y="312" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_l_idp" value="Identity" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="766" width="300" height="210" as="geometry"/></mxCell><mxCell id="p1_n_cl-id" value="&lt;b&gt;Keycloak (OIDC)&lt;/b&gt;&lt;br&gt;The identity provider that logs the person in.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/openid-client.provider.ts &amp;gt; OpenIdClientProvider&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_idp"><mxGeometry x="20" y="56" width="260" height="134" as="geometry"/></mxCell><mxCell id="p1_e0" value="validate and build" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_in-manual" target="p1_n_app-rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e1" value="read, classify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_in-import" target="p1_n_app-rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="restore" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_in-backup" target="p1_n_app-state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e3" value="transact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_app-rules" target="p1_n_app-state"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e4" value="render" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_app-state" target="p1_n_out-screens"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e5" value="report data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_app-rules" target="p1_n_out-report"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e6" value="optional" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_app-state" target="p1_n_cl-sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e7" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_cl-sync" target="p1_n_cl-api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e8" value="Prisma" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_cl-api" target="p1_n_cl-db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e9" value="OIDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_cl-api" target="p1_n_cl-id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="1229" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="180" y="1229" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Results and outputs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="1"><mxGeometry x="340" y="1229" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg3" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="500" y="1229" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg4" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="660" y="1229" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg5" value="External integrations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1"><mxGeometry x="820" y="1229" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1263" width="1080" height="28" as="geometry"/></mxCell><mxCell id="p1_note0" value="In the Android app the cloud part is switched off: the app keeps its data on the phone (ADR-0014). No market data, price or Open Finance service is called: balances and prices are typed or imported." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1295" width="1080" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
