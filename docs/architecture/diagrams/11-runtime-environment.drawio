<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Everfox: Runtime and Environment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="873" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Runtime and Environment&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Names of settings only; values and secrets are never written here.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="70" as="geometry"/></mxCell><mxCell id="p1_l_web" value="Browser app" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="512" as="geometry"/></mxCell><mxCell id="p1_n_e-src" value="&lt;b&gt;Source, served by any static server&lt;/b&gt;&lt;br&gt;scripts/serve.sh serves the folder on port 8000; ES modules need http, not file://.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;scripts/serve.sh &amp;gt; http.server&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_web"><mxGeometry x="20" y="56" width="260" height="138" as="geometry"/></mxCell><mxCell id="p1_n_e-dist" value="&lt;b&gt;Single-file build&lt;/b&gt;&lt;br&gt;npm run build bundles src/ into dist/finance_goal_1300k.html (opens from file://) and dist/index.html.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;tools/module-graph.cjs &amp;gt; moduleOrder&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_web"><mxGeometry x="20" y="214" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_e-test" value="&lt;b&gt;Tests&lt;/b&gt;&lt;br&gt;npm run test:unit (plain Node), npm run test:e2e (headless Chrome smokes), npm run test:mobile (widths), npm run check (everything).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;tests/run-unit.js &amp;gt; readdirSync&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_web"><mxGeometry x="20" y="356" width="260" height="136" as="geometry"/></mxCell><mxCell id="p1_l_stack" value="Full local stack (Docker)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="665" as="geometry"/></mxCell><mxCell id="p1_n_e-up" value="&lt;b&gt;npm run dev:up&lt;/b&gt;&lt;br&gt;Starts db (127.0.0.1:5433), keycloak (8081), migrate, api (3000) and loads demo data.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;scripts/dev.sh &amp;gt; up&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_stack"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_e-api" value="&lt;b&gt;API entry point&lt;/b&gt;&lt;br&gt;backend/src/main.ts reads the environment once, builds the app and listens; shutdown on SIGTERM and SIGINT.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/main.ts &amp;gt; registerGracefulShutdown&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_stack"><mxGeometry x="20" y="198" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_e-env" value="&lt;b&gt;Settings (names)&lt;/b&gt;&lt;br&gt;DATABASE_URL, MIGRATE_DATABASE_URL, NODE_ENV, HOST, PORT, LOG_LEVEL, HEALTH_CHECK_TIMEOUT_MS, APP_BASE_URL, OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/.env.example &amp;gt; DATABASE_URL&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_stack"><mxGeometry x="20" y="353" width="260" height="150" as="geometry"/></mxCell><mxCell id="p1_n_e-be" value="&lt;b&gt;Backend tests&lt;/b&gt;&lt;br&gt;npm test in backend/ with a real PostgreSQL and a real Keycloak (the CI job &amp;quot;backend&amp;quot;).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/package.json &amp;gt; test&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_stack"><mxGeometry x="20" y="523" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_l_and" value="Android" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="495" as="geometry"/></mxCell><mxCell id="p1_n_e-apk" value="&lt;b&gt;npm run mobile:apk&lt;/b&gt;&lt;br&gt;Builds the page for the shell (own CSP), copies it into android/, builds the debug APK. ANDROID_HOME defaults to ~/Android/Sdk.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;scripts/mobile.sh &amp;gt; apk&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_and"><mxGeometry x="20" y="56" width="260" height="136" as="geometry"/></mxCell><mxCell id="p1_n_e-emu" value="&lt;b&gt;Emulator tests&lt;/b&gt;&lt;br&gt;npm run mobile:test and mobile:test-lock drive the real app on a virtual phone with adb and the DevTools protocol.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;scripts/device-test.mjs &amp;gt; step&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_and"><mxGeometry x="20" y="212" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_e-send" value="&lt;b&gt;npm run apk:send -- --build&lt;/b&gt;&lt;br&gt;Builds, then asks before sending the APK to a Telegram chat.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;services/telegram-apk/send-apk.mjs &amp;gt; main&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_and"><mxGeometry x="20" y="354" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="785" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="180" y="785" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="340" y="785" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="819" width="1080" height="28" as="geometry"/></mxCell><mxCell id="p1_note0" value="CI (.github/workflows/ci.yml) runs four jobs on every push: check, backend, stack, android." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="851" width="1080" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
