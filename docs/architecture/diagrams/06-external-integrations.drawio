<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Everfox: Integrations and Data Sources"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1112" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Integrations and Data Sources&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;The app itself calls no third-party service. The API calls one identity provider and one database. Prices, balances and market data are typed or imported from files.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="70" as="geometry"/></mxCell><mxCell id="p1_l_who" value="Who calls" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="904" as="geometry"/></mxCell><mxCell id="p1_n_w-oidc" value="&lt;b&gt;OpenIdClientProvider&lt;/b&gt;&lt;br&gt;At login (authorization request, code exchange) and logout (end-session address). Errors: a failed start answers 503; a failed callback ends in the login-failed page; a missing end-session address is null, logout still works.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/openid-client.provider.ts &amp;gt; OpenIdClientProvider&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_who"><mxGeometry x="20" y="56" width="260" height="190" as="geometry"/></mxCell><mxCell id="p1_n_w-prisma" value="&lt;b&gt;PrismaService&lt;/b&gt;&lt;br&gt;Every request that reads or writes data. Connects on first use, so the API can start before the database. Ready check has a timeout.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/database/prisma.service.ts &amp;gt; PrismaService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_who"><mxGeometry x="20" y="266" width="260" height="149" as="geometry"/></mxCell><mxCell id="p1_n_w-share" value="&lt;b&gt;shareTextFile and AppLockPlugin&lt;/b&gt;&lt;br&gt;Android only: share sheet (backup file) and BiometricPrompt (app lock). A cancelled sheet or prompt is an answer, not an error.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/native-bridge.js &amp;gt; shareTextFile&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_who"><mxGeometry x="20" y="435" width="260" height="152" as="geometry"/></mxCell><mxCell id="p1_n_w-tg" value="&lt;b&gt;Telegram APK service&lt;/b&gt;&lt;br&gt;Developer tool, not part of the app: sends the debug APK to a chat. Token only from an ignored .env; errors never print it.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;services/telegram-apk/lib/telegram.mjs &amp;gt; createTelegram&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_who"><mxGeometry x="20" y="607" width="260" height="149" as="geometry"/></mxCell><mxCell id="p1_n_w-pdf" value="&lt;b&gt;pdf.js (vendored copy)&lt;/b&gt;&lt;br&gt;Reads the text of a PDF in the page, from a local file; no network.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/pdf-text.js &amp;gt; pdfText&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_who"><mxGeometry x="20" y="776" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_l_ext" value="External system or platform" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="750" as="geometry"/></mxCell><mxCell id="p1_n_x-kc" value="&lt;b&gt;Keycloak (OIDC)&lt;/b&gt;&lt;br&gt;Identity provider. Local: Docker Compose, development realm. Endpoint comes from OIDC_ISSUER.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;docker-compose.yml &amp;gt; keycloak:&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_ext"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_x-pg" value="&lt;b&gt;PostgreSQL 18&lt;/b&gt;&lt;br&gt;The only database. Local: Docker Compose, port 5433 on the host. Limits: one instance, no hosted copy yet.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;docker-compose.yml &amp;gt; postgres:&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_ext"><mxGeometry x="20" y="198" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_x-and" value="&lt;b&gt;Android system&lt;/b&gt;&lt;br&gt;BiometricPrompt (fingerprint, face or phone PIN), share sheet, file cache.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;android/app/src/main/java/com/everfox/app/AppLockPlugin.java &amp;gt; AppLockPlugin&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_ext"><mxGeometry x="20" y="340" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_x-tg" value="&lt;b&gt;Telegram Bot API&lt;/b&gt;&lt;br&gt;api.telegram.org: getMe, getChat, sendMessage, sendDocument (50 MB limit).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;services/telegram-apk/lib/telegram.mjs &amp;gt; DEFAULT_API&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_ext"><mxGeometry x="20" y="481" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_x-pdfjs" value="&lt;b&gt;No network&lt;/b&gt;&lt;br&gt;The PDF library ships inside the repository.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;vendor/pdfjs/pdf.min.mjs&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_ext"><mxGeometry x="20" y="622" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_l_none" value="Searched and not found" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="498" as="geometry"/></mxCell><mxCell id="p1_n_z-mkt" value="&lt;b&gt;Market data and prices&lt;/b&gt;&lt;br&gt;No call to any price, quote or fundamentals service in src, backend, services or scripts.&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: NOT IDENTIFIED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_none"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_z-brk" value="&lt;b&gt;Brokers, OpLab, Bolsai, Open Finance, Tesouro Direto&lt;/b&gt;&lt;br&gt;No code or configuration refers to them. Investments are typed, or read from files (OFX, CSV, PDF, B3 brokerage notes).&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: NOT IDENTIFIED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_none"><mxGeometry x="20" y="198" width="260" height="152" as="geometry"/></mxCell><mxCell id="p1_n_z-pay" value="&lt;b&gt;Payments and billing&lt;/b&gt;&lt;br&gt;Plans exist as data and a guard; there is no payment provider.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/features.ts &amp;gt; FEATURES&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: PARTIAL&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_none"><mxGeometry x="20" y="370" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_e0" value="OIDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_w-oidc" target="p1_n_x-kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e1" value="Prisma" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_w-prisma" target="p1_n_x-pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="Capacitor plugins" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_w-share" target="p1_n_x-and"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e3" value="HTTPS multipart" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_w-tg" target="p1_n_x-tg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e4" value="local file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_w-pdf" target="p1_n_x-pdfjs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="20" y="1024" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="External integrations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1"><mxGeometry x="180" y="1024" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Errors and attention points" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="340" y="1024" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1058" width="1080" height="28" as="geometry"/></mxCell><mxCell id="p1_note0" value="GitHub Actions (.github/workflows/ci.yml) runs the checks and builds the debug APK; it is not called by the running app." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1090" width="1080" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
