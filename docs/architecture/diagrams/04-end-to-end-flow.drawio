<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Add an expense"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="616" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Flow of Adding an Expense&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;From the + button to the new number on the Summary. Nothing leaves the device in this flow.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="p1_l_s1" value="1. Open" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="184" as="geometry"/></mxCell><mxCell id="p1_n_a-open" value="&lt;b&gt;Open the form&lt;/b&gt;&lt;br&gt;The + button opens the form in a sheet; the date starts as today.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/item-dialog.js &amp;gt; openItem&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_s1"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_l_s2" value="2. Fill" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="239" as="geometry"/></mxCell><mxCell id="p1_n_a-fill" value="&lt;b&gt;Fill the form&lt;/b&gt;&lt;br&gt;Value, date, category, account. Optional help: a short sentence fills the form (nothing is saved until Salvar), and a past description offers its category (never applied alone).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/quick-entry.js &amp;gt; parseQuickEntry&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_s2"><mxGeometry x="20" y="56" width="260" height="163" as="geometry"/></mxCell><mxCell id="p1_l_s3" value="3. Validate" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="325" as="geometry"/></mxCell><mxCell id="p1_n_a-valid" value="&lt;b&gt;Valid?&lt;/b&gt;&lt;br&gt;Value above zero, a date, a destination for an aporte, splits not above the total.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/transaction-builder.js &amp;gt; validateTransaction&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=30;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="p1_l_s3"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_a-err" value="&lt;b&gt;Message under the field&lt;/b&gt;&lt;br&gt;The form stays open with what was typed.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/components/field-error.js&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_s3"><mxGeometry x="20" y="211" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_l_s4" value="4. Save" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1190" y="96" width="300" height="339" as="geometry"/></mxCell><mxCell id="p1_n_a-build" value="&lt;b&gt;Build the record&lt;/b&gt;&lt;br&gt;Copies the form into a transaction; a monthly series or an edit with future siblings.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/transaction-builder.js &amp;gt; saveTransaction&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_s4"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_a-tx" value="&lt;b&gt;transact()&lt;/b&gt;&lt;br&gt;Runs the change and saves; if saving fails the change is undone.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/store.js &amp;gt; transact&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_s4"><mxGeometry x="20" y="211" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_l_s5" value="5. React" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1580" y="96" width="300" height="426" as="geometry"/></mxCell><mxCell id="p1_n_a-render" value="&lt;b&gt;Redraw&lt;/b&gt;&lt;br&gt;render() redraws the screens from the new state.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/render.js &amp;gt; render&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p1_l_s5"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_a-budget" value="&lt;b&gt;Budget warning&lt;/b&gt;&lt;br&gt;Saving an expense over its group budget warns.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/budgets.js &amp;gt; budgetAlerts&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p1_l_s5"><mxGeometry x="20" y="184" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_a-undo" value="&lt;b&gt;Toast with Desfazer&lt;/b&gt;&lt;br&gt;The record can be brought back.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/toast.js &amp;gt; toast&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p1_l_s5"><mxGeometry x="20" y="312" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_a-open" target="p1_n_a-fill"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e1" value="Salvar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_a-fill" target="p1_n_a-valid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_a-valid" target="p1_n_a-err"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_a-valid" target="p1_n_a-build"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_a-build" target="p1_n_a-tx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e5" value="saved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_a-tx" target="p1_n_a-render"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_a-render" target="p1_n_a-budget"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_a-budget" target="p1_n_a-undo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="546" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Decisions and validations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="180" y="546" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Errors and attention points" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="340" y="546" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg3" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="500" y="546" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg4" value="Results and outputs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="1"><mxGeometry x="660" y="546" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="580" width="1400" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p2" name="Import a bank file"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="529" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Flow of Importing a Bank File&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;OFX, CSV or digital PDF becomes drafts the person reviews; only the confirmation writes to the state.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="p2_l_s1" value="1. Pick the file" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="324" as="geometry"/></mxCell><mxCell id="p2_n_i-pick" value="&lt;b&gt;Choose a file&lt;/b&gt;&lt;br&gt;The file input of the Importar panel.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/import-load.js &amp;gt; loadImportFile&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p2_l_s1"><mxGeometry x="20" y="56" width="260" height="107" as="geometry"/></mxCell><mxCell id="p2_n_i-lim" value="&lt;b&gt;Size and type checks&lt;/b&gt;&lt;br&gt;Up to 2 MB (PDF 10 MB, 40 pages, 3000 entries); csv, ofx, qfx, txt, pdf only.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/import-reader.js &amp;gt; IMPORT_LIMITS&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p2_l_s1"><mxGeometry x="20" y="183" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_l_s2" value="2. Read" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="339" as="geometry"/></mxCell><mxCell id="p2_n_i-pdf" value="&lt;b&gt;PDF text&lt;/b&gt;&lt;br&gt;pdf.js (a vendored copy) extracts the text of a digital PDF; photos and scans are refused.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/pdf-text.js &amp;gt; pdfText&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p2_l_s2"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p2_n_i-read" value="&lt;b&gt;Choose the reader by content&lt;/b&gt;&lt;br&gt;OFX, CSV or PDF statement / card invoice become raw entries.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/import-reader.js &amp;gt; readImportFile&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p2_l_s2"><mxGeometry x="20" y="198" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_l_s3" value="3. Classify" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="338" as="geometry"/></mxCell><mxCell id="p2_n_i-class" value="&lt;b&gt;What is each entry?&lt;/b&gt;&lt;br&gt;Balance lines dropped; income, expense, own transfer, aporte, or ignore (invoice payment, refund, redemption, yield).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/import-classify.js &amp;gt; IMPORT_TYPE&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p2_l_s3"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p2_n_i-dup" value="&lt;b&gt;Possible duplicates&lt;/b&gt;&lt;br&gt;Marks drafts that may already exist.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/import-duplicates.js &amp;gt; markDuplicates&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p2_l_s3"><mxGeometry x="20" y="211" width="260" height="107" as="geometry"/></mxCell><mxCell id="p2_l_s4" value="4. Review" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1190" y="96" width="300" height="311" as="geometry"/></mxCell><mxCell id="p2_n_i-review" value="&lt;b&gt;Review screen&lt;/b&gt;&lt;br&gt;Edit a row, remove one, divide across categories, select or deselect.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/import-review.js &amp;gt; reviewHtml&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p2_l_s4"><mxGeometry x="20" y="56" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_i-ok" value="&lt;b&gt;Confirm?&lt;/b&gt;&lt;br&gt;The confirmation shows the totals first.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/import-confirm.js&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=30;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="p2_l_s4"><mxGeometry x="20" y="197" width="260" height="94" as="geometry"/></mxCell><mxCell id="p2_l_s5" value="5. Commit" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1580" y="96" width="300" height="339" as="geometry"/></mxCell><mxCell id="p2_n_i-commit" value="&lt;b&gt;commitImport&lt;/b&gt;&lt;br&gt;The only place where reviewed drafts become transactions, inside transact().&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/import-commit.js &amp;gt; commitImport&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p2_l_s5"><mxGeometry x="20" y="56" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_i-res" value="&lt;b&gt;Result per item&lt;/b&gt;&lt;br&gt;Saved, skipped and kept-unsaved items are listed; the same file again adds nothing.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/import-result.js&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="p2_l_s5"><mxGeometry x="20" y="197" width="260" height="122" as="geometry"/></mxCell><mxCell id="p2_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_n_i-pick" target="p2_n_i-lim"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e1" value="pdf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_i-lim" target="p2_n_i-pdf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_n_i-pdf" target="p2_n_i-read"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_i-read" target="p2_n_i-class"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_n_i-class" target="p2_n_i-dup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_i-dup" target="p2_n_i-review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_n_i-review" target="p2_n_i-ok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_i-ok" target="p2_n_i-commit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2_n_i-commit" target="p2_n_i-res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="459" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg1" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="180" y="459" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg2" value="Decisions and validations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="340" y="459" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg3" value="Results and outputs" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#333333" vertex="1" parent="1"><mxGeometry x="500" y="459" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="493" width="1400" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p3" name="One sync run"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="518" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Flow of One Sync Run (web app)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Offline first: the outbox keeps what was not confirmed. Not part of the Android app yet.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="p3_l_s1" value="1. A change is saved" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="170" as="geometry"/></mxCell><mxCell id="p3_n_y-save" value="&lt;b&gt;Saved state&lt;/b&gt;&lt;br&gt;Every save tells its listeners.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/store.js &amp;gt; onSave&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p3_l_s1"><mxGeometry x="20" y="56" width="260" height="94" as="geometry"/></mxCell><mxCell id="p3_l_s2" value="2. Queue" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="312" as="geometry"/></mxCell><mxCell id="p3_n_y-split" value="&lt;b&gt;Split into records&lt;/b&gt;&lt;br&gt;The state is split like the server does, each record with a fingerprint.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/records.js &amp;gt; splitState&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p3_l_s2"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p3_n_y-queue" value="&lt;b&gt;Outbox entries&lt;/b&gt;&lt;br&gt;Only what changed since the last run becomes an entry.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/outbox.js &amp;gt; queueChanges&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p3_l_s2"><mxGeometry x="20" y="184" width="260" height="108" as="geometry"/></mxCell><mxCell id="p3_l_s3" value="3. Push" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="312" as="geometry"/></mxCell><mxCell id="p3_n_y-push" value="&lt;b&gt;Send in batches of 100&lt;/b&gt;&lt;br&gt;POST /api/v1/sync/push; entries are marked as attempted first.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/runner.js &amp;gt; BATCH&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p3_l_s3"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p3_n_y-rej" value="&lt;b&gt;Rejected?&lt;/b&gt;&lt;br&gt;A rejected mutation goes to the review list; the batch stops there.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/runner.js &amp;gt; review&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=30;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="p3_l_s3"><mxGeometry x="20" y="184" width="260" height="108" as="geometry"/></mxCell><mxCell id="p3_l_s4" value="4. Pull" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1190" y="96" width="300" height="328" as="geometry"/></mxCell><mxCell id="p3_n_y-pull" value="&lt;b&gt;Ask for changes after the cursor&lt;/b&gt;&lt;br&gt;GET /api/v1/sync/changes, page by page until no more.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/api-client.js &amp;gt; createApiClient&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p3_l_s4"><mxGeometry x="20" y="56" width="260" height="124" as="geometry"/></mxCell><mxCell id="p3_n_y-apply" value="&lt;b&gt;Merge into the state&lt;/b&gt;&lt;br&gt;applyChanges puts them in without echoing them back.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/apply.js &amp;gt; applyChanges&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p3_l_s4"><mxGeometry x="20" y="200" width="260" height="108" as="geometry"/></mxCell><mxCell id="p3_l_s5" value="5. Failure" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1580" y="96" width="300" height="214" as="geometry"/></mxCell><mxCell id="p3_n_y-fail" value="&lt;b&gt;offline, unauthorized or server&lt;/b&gt;&lt;br&gt;During the push or the pull. The outbox stays as it is; the person sees the state on the sync card.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/sync-view.js &amp;gt; renderSync&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p3_l_s5"><mxGeometry x="20" y="56" width="260" height="138" as="geometry"/></mxCell><mxCell id="p3_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_n_y-save" target="p3_n_y-split"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3_n_y-split" target="p3_n_y-queue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_n_y-queue" target="p3_n_y-push"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3_n_y-push" target="p3_n_y-rej"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e4" value="no / handled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_n_y-rej" target="p3_n_y-pull"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3_n_y-pull" target="p3_n_y-apply"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_e6" value="any step fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3_n_y-pull" target="p3_n_y-fail"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="448" width="150" height="26" as="geometry"/></mxCell><mxCell id="p3_lg1" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="180" y="448" width="150" height="26" as="geometry"/></mxCell><mxCell id="p3_lg2" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="340" y="448" width="150" height="26" as="geometry"/></mxCell><mxCell id="p3_lg3" value="Decisions and validations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="500" y="448" width="150" height="26" as="geometry"/></mxCell><mxCell id="p3_lg4" value="Errors and attention points" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="660" y="448" width="150" height="26" as="geometry"/></mxCell><mxCell id="p3_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="482" width="1400" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
