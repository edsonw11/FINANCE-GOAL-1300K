<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Everfox: Architectural Evolution"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1136" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Architectural Evolution&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Current state first, then what limits it, then proposals. A PROPOSAL is not implemented.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="70" as="geometry"/></mxCell><mxCell id="p1_l_now" value="Current architecture" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="495" as="geometry"/></mxCell><mxCell id="p1_n_v-now1" value="&lt;b&gt;Rules shared by browser and API&lt;/b&gt;&lt;br&gt;One set of files runs in both places (ADR-0001, ADR-0006).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/domain/domain-runtime.ts &amp;gt; loadDomain&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_now"><mxGeometry x="20" y="56" width="260" height="137" as="geometry"/></mxCell><mxCell id="p1_n_v-now2" value="&lt;b&gt;Offline-first sync&lt;/b&gt;&lt;br&gt;Outbox, cursor and idempotent mutations (ADR-0008, ADR-0010).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/sync/sync.service.ts &amp;gt; SyncService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_now"><mxGeometry x="20" y="213" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_v-now3" value="&lt;b&gt;Android shell&lt;/b&gt;&lt;br&gt;Same page in a WebView, offline, app lock (ADR-0014).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;android/app/src/main/java/com/everfox/app/MainActivity.java &amp;gt; MainActivity&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_now"><mxGeometry x="20" y="354" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_l_prob" value="Observed limits and risks" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="905" as="geometry"/></mxCell><mxCell id="p1_n_v-p1" value="&lt;b&gt;The API is not hosted&lt;/b&gt;&lt;br&gt;It only runs in Docker on a developer machine; the web app has no production address.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;docker-compose.yml &amp;gt; api:&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_prob"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_v-p2" value="&lt;b&gt;Android has no login or sync&lt;/b&gt;&lt;br&gt;The shell makes no network calls; the cookie login of the web app does not carry over to another origin.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/sync-view.js &amp;gt; bindSync&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_prob"><mxGeometry x="20" y="198" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_v-p3" value="&lt;b&gt;Rate limits are per instance&lt;/b&gt;&lt;br&gt;Counters live in memory; behind several instances the limits multiply.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/security/rate-limiter.ts &amp;gt; RateLimiter&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_prob"><mxGeometry x="20" y="340" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_v-p4" value="&lt;b&gt;Records are JSON bodies&lt;/b&gt;&lt;br&gt;Money and dates are not typed columns; SQL reports and constraints cannot use them.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/prisma/schema.prisma &amp;gt; model Record&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_prob"><mxGeometry x="20" y="481" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_v-p5" value="&lt;b&gt;Little to observe&lt;/b&gt;&lt;br&gt;Logs only; no metrics, traces or error reporting were found.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/logging/nest-log-levels.ts &amp;gt; nestLogLevels&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: NOT IDENTIFIED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_prob"><mxGeometry x="20" y="636" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_v-p6" value="&lt;b&gt;No billing&lt;/b&gt;&lt;br&gt;Plans and feature locks exist; nothing charges or changes a plan by itself.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/features.ts &amp;gt; FEATURES&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: PARTIAL&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_prob"><mxGeometry x="20" y="777" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_l_opp" value="Proposals" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="946" as="geometry"/></mxCell><mxCell id="p1_n_v-o1" value="&lt;b&gt;Host the API and the web app&lt;/b&gt;&lt;br&gt;Run the container behind a proxy with trustProxy set on purpose (AWS, phases 9 and 10 of the plan).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;docs/architecture/00-current-state.md &amp;gt; Phase&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: PROPOSAL&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_opp"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_v-o2" value="&lt;b&gt;Phone sign-in for Android&lt;/b&gt;&lt;br&gt;System browser, app link and a token in the Android Keystore, with its own threat model.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;docs/architecture/decisions/ADR-0014-android-shell.md &amp;gt; sign-in&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: PROPOSAL&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_opp"><mxGeometry x="20" y="211" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_v-o3" value="&lt;b&gt;Shared rate-limit store&lt;/b&gt;&lt;br&gt;Move the counters to a shared store when more than one instance runs.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/security/rate-limiter.ts &amp;gt; RateLimiter&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: PROPOSAL&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_opp"><mxGeometry x="20" y="366" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_v-o4" value="&lt;b&gt;Typed columns and command endpoints&lt;/b&gt;&lt;br&gt;Phase 4b-2: cents and dates as columns, endpoints that run one command each.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;docs/architecture/00-current-state.md &amp;gt; 4b&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: PROPOSAL&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_opp"><mxGeometry x="20" y="507" width="260" height="137" as="geometry"/></mxCell><mxCell id="p1_n_v-o5" value="&lt;b&gt;Metrics and error reporting&lt;/b&gt;&lt;br&gt;Request counts and latency, errors with context, a dashboard.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/logging/nest-log-levels.ts &amp;gt; nestLogLevels&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: PROPOSAL&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_opp"><mxGeometry x="20" y="664" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_v-o6" value="&lt;b&gt;Billing&lt;/b&gt;&lt;br&gt;Web checkout and Play Billing mapped to plans (phase 8b).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;docs/architecture/00-current-state.md &amp;gt; 8b&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: PROPOSAL&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_opp"><mxGeometry x="20" y="805" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_e0" value="addressed by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_v-p1" target="p1_n_v-o1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e1" value="addressed by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_v-p2" target="p1_n_v-o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="addressed by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_v-p3" target="p1_n_v-o3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e3" value="addressed by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_v-p4" target="p1_n_v-o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e4" value="addressed by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_v-p5" target="p1_n_v-o5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e5" value="addressed by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_v-p6" target="p1_n_v-o6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="20" y="1066" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Errors and attention points" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="180" y="1066" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="External integrations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1"><mxGeometry x="340" y="1066" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1100" width="1080" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
