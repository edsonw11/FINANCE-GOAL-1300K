<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Everfox: High-Level Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1879" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: High-Level Architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;One code base for the rules (src/core and src/domain), used by the browser app and, on the server, by the API.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="70" as="geometry"/></mxCell><mxCell id="p1_l_clients" value="Clients" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="339" as="geometry"/></mxCell><mxCell id="p1_n_browser" value="&lt;b&gt;Browser app&lt;/b&gt;&lt;br&gt;Plain ES modules (index.html + src/), or the single-file build in dist/. Keeps its data in the browser.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/app.js &amp;gt; bindNavigation&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_clients"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_android" value="&lt;b&gt;Android shell&lt;/b&gt;&lt;br&gt;Capacitor 8 around the same page, with its own CSP, offline, app lock.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;android/app/src/main/java/com/everfox/app/MainActivity.java &amp;gt; MainActivity&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_clients"><mxGeometry x="20" y="198" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_l_api" value="API (NestJS 12 on Fastify 5)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="1184" as="geometry"/></mxCell><mxCell id="p1_n_b-sec" value="&lt;b&gt;Security layer&lt;/b&gt;&lt;br&gt;Rate limits, CSRF by origin, login check, plan and admin guards, security headers.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/security/security.module.ts &amp;gt; SecurityModule&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_b-web" value="&lt;b&gt;Web&lt;/b&gt;&lt;br&gt;Serves the browser app files (an allow-list of src/ and vendor/).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/web/web.module.ts &amp;gt; WebModule&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="211" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_b-health" value="&lt;b&gt;Health&lt;/b&gt;&lt;br&gt;Live and ready checks (ready asks the database).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/health/health.module.ts &amp;gt; HealthModule&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="352" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_b-auth" value="&lt;b&gt;Auth&lt;/b&gt;&lt;br&gt;OIDC login, cookie sessions, who am I.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/auth.module.ts &amp;gt; AuthModule&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="493" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_n_b-plans" value="&lt;b&gt;Plans&lt;/b&gt;&lt;br&gt;Plan features per person and admin routes.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/plans.module.ts &amp;gt; PlansModule&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="620" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_b-acc" value="&lt;b&gt;Accounts&lt;/b&gt;&lt;br&gt;Accounts of a person (REST).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/accounts/accounts.module.ts &amp;gt; AccountsModule&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="761" width="260" height="107" as="geometry"/></mxCell><mxCell id="p1_n_b-sync" value="&lt;b&gt;Sync&lt;/b&gt;&lt;br&gt;Push of offline changes, pull of changes after a cursor.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/sync/sync.module.ts &amp;gt; SyncModule&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="888" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_b-rules" value="&lt;b&gt;Month rules and import/export&lt;/b&gt;&lt;br&gt;Month summary, result and report computed by the shared rules; import and export of the whole state.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/legacy/legacy.module.ts &amp;gt; LegacyModule&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="1029" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_l_data" value="Data and identity" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="351" as="geometry"/></mxCell><mxCell id="p1_n_pg" value="&lt;b&gt;PostgreSQL 18&lt;/b&gt;&lt;br&gt;Tables app_user, session, record, user_state, sync_*, plan, audit_log.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/database/prisma.service.ts &amp;gt; PrismaService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="56" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_kc" value="&lt;b&gt;Keycloak 26&lt;/b&gt;&lt;br&gt;OpenID Connect identity provider (development realm in Docker Compose).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/openid-client.provider.ts &amp;gt; OpenIdClientProvider&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="p1_l_data"><mxGeometry x="20" y="197" width="260" height="134" as="geometry"/></mxCell><mxCell id="p1_l_shared" value="Shared rules" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="1328" width="300" height="211" as="geometry"/></mxCell><mxCell id="p1_n_rules" value="&lt;b&gt;src/core + src/domain&lt;/b&gt;&lt;br&gt;The same plain JavaScript files, loaded by the API at start and run on one person's state.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/domain/domain-runtime.ts &amp;gt; loadDomain&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_shared"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_l_delivery" value="Build and delivery" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="1328" width="300" height="439" as="geometry"/></mxCell><mxCell id="p1_n_ci" value="&lt;b&gt;CI (GitHub Actions)&lt;/b&gt;&lt;br&gt;Jobs: check, backend, stack, android.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;.github/workflows/ci.yml &amp;gt; android:&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_delivery"><mxGeometry x="20" y="56" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_n_compose" value="&lt;b&gt;Docker Compose&lt;/b&gt;&lt;br&gt;db, keycloak, migrate, api for the local full stack.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;docker-compose.yml &amp;gt; keycloak:&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_delivery"><mxGeometry x="20" y="170" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_tg" value="&lt;b&gt;APK to Telegram&lt;/b&gt;&lt;br&gt;Developer tool that sends the debug APK to a chat.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;services/telegram-apk/send-apk.mjs &amp;gt; main&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_delivery"><mxGeometry x="20" y="298" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_e0" value="GET page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_browser" target="p1_n_b-web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e1" value="login" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_browser" target="p1_n_b-auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="push / changes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_browser" target="p1_n_b-sync"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e3" value="OIDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_b-auth" target="p1_n_kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e4" value="Prisma" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_b-sync" target="p1_n_pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e5" value="loads at start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_b-rules" target="p1_n_rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="1791" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="180" y="1791" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="340" y="1791" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg3" value="External integrations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1"><mxGeometry x="500" y="1791" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg4" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="660" y="1791" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1825" width="1080" height="28" as="geometry"/></mxCell><mxCell id="p1_note0" value="The Android shell makes no network calls (connect-src none): sync and login are not part of it yet. Only the browser app talks to the API." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1857" width="1080" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
