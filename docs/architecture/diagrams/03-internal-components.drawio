<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Browser app"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="1409" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Components of the Browser App&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;src/ in four layers. Core and domain never touch the page (checked by tests/unit/architecture.test.js); the screens call domain commands.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="p1_l_sync" value="Sync client (src/sync)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="696" as="geometry"/></mxCell><mxCell id="p1_n_s-run" value="&lt;b&gt;runner.js&lt;/b&gt;&lt;br&gt;One sync run: send the outbox, then pull changes.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/runner.js &amp;gt; createSync&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_sync"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_s-out" value="&lt;b&gt;outbox.js&lt;/b&gt;&lt;br&gt;What waits to be sent; turns a changed state into entries.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/outbox.js &amp;gt; queueChanges&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_sync"><mxGeometry x="20" y="184" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_s-rec" value="&lt;b&gt;records.js&lt;/b&gt;&lt;br&gt;How the state splits into records, and the fingerprint of each.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/records.js &amp;gt; splitState&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_sync"><mxGeometry x="20" y="312" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_s-app" value="&lt;b&gt;apply.js&lt;/b&gt;&lt;br&gt;Puts pulled changes into the local state.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/apply.js &amp;gt; applyChanges&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_sync"><mxGeometry x="20" y="440" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_s-api" value="&lt;b&gt;api-client.js&lt;/b&gt;&lt;br&gt;The calls to the API; failures become offline, unauthorized or server.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/api-client.js &amp;gt; createApiClient&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_sync"><mxGeometry x="20" y="568" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_l_ui" value="Screens (src/ui)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="709" as="geometry"/></mxCell><mxCell id="p1_n_u-app" value="&lt;b&gt;app.js&lt;/b&gt;&lt;br&gt;Starts everything in order and draws the first time.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/app.js &amp;gt; bindNavigation&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_ui"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_u-nav" value="&lt;b&gt;navigation and render&lt;/b&gt;&lt;br&gt;Tabs and the one render() that redraws the page.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/render.js &amp;gt; render&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_ui"><mxGeometry x="20" y="184" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_u-views" value="&lt;b&gt;views/&lt;/b&gt;&lt;br&gt;One module per screen or card (summary, list, card, goal, import, backup...).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/views/kpi.js &amp;gt; kpi&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_ui"><mxGeometry x="20" y="312" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_u-comp" value="&lt;b&gt;components/&lt;/b&gt;&lt;br&gt;Sheet, confirmation, money and date inputs, command runner.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/components/command.js &amp;gt; runCommand&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_ui"><mxGeometry x="20" y="440" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_u-native" value="&lt;b&gt;native-bridge and app-lock&lt;/b&gt;&lt;br&gt;Android only: share sheet, Back button, app lock.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/native-bridge.js &amp;gt; bindNativeBack&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_ui"><mxGeometry x="20" y="581" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_l_dom" value="Domain (src/domain)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="1219" as="geometry"/></mxCell><mxCell id="p1_n_d-store" value="&lt;b&gt;store.js&lt;/b&gt;&lt;br&gt;The state S, its saving, transact(), withState().&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/store.js &amp;gt; transact&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_dom"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_d-tx" value="&lt;b&gt;Transactions&lt;/b&gt;&lt;br&gt;Create and edit a transaction; month queries.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/transaction-builder.js &amp;gt; saveTransaction&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_dom"><mxGeometry x="20" y="184" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_d-month" value="&lt;b&gt;Month numbers&lt;/b&gt;&lt;br&gt;Income, expenses, left, savings level.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/month-result.js &amp;gt; monthResult&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_dom"><mxGeometry x="20" y="325" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_n_d-card" value="&lt;b&gt;Credit card&lt;/b&gt;&lt;br&gt;Cycle, closing, due date, invoices, payment.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/card-cycle.js &amp;gt; dueMonth&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_dom"><mxGeometry x="20" y="439" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_d-goal" value="&lt;b&gt;Goal and wealth&lt;/b&gt;&lt;br&gt;Projection, real series, reserve, allocation.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/goal-projection.js &amp;gt; projectionPlan&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_dom"><mxGeometry x="20" y="567" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_d-port" value="&lt;b&gt;Portfolio&lt;/b&gt;&lt;br&gt;Positions with average cost from the trades.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/portfolio.js &amp;gt; positions&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_dom"><mxGeometry x="20" y="708" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_d-imp" value="&lt;b&gt;Import pipeline&lt;/b&gt;&lt;br&gt;Read OFX/CSV/PDF, classify, find duplicates, commit.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/import-commit.js &amp;gt; commitImport&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_dom"><mxGeometry x="20" y="836" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_d-rep" value="&lt;b&gt;Report&lt;/b&gt;&lt;br&gt;Every number of the monthly report.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/report.js &amp;gt; buildReport&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_dom"><mxGeometry x="20" y="977" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_n_d-rec" value="&lt;b&gt;State recovery&lt;/b&gt;&lt;br&gt;Unreadable data is kept aside; one copy per day.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/state-recovery.js &amp;gt; readState&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_dom"><mxGeometry x="20" y="1091" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_l_core" value="Core (src/core)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1190" y="96" width="300" height="667" as="geometry"/></mxCell><mxCell id="p1_n_c-money" value="&lt;b&gt;money.js&lt;/b&gt;&lt;br&gt;Amounts as numbers rounded to cents.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/core/money.js &amp;gt; roundMoney&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_core"><mxGeometry x="20" y="56" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_n_c-dates" value="&lt;b&gt;dates.js&lt;/b&gt;&lt;br&gt;Dates and month keys (yyyy-mm).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/core/dates.js &amp;gt; mKey&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_core"><mxGeometry x="20" y="170" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_n_c-fmt" value="&lt;b&gt;format.js&lt;/b&gt;&lt;br&gt;Brazilian number format and parsing.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/core/format.js &amp;gt; m2&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_core"><mxGeometry x="20" y="284" width="260" height="94" as="geometry"/></mxCell><mxCell id="p1_n_c-text" value="&lt;b&gt;text-normalize.js&lt;/b&gt;&lt;br&gt;Lowercase, no accents, for matching descriptions.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/core/text-normalize.js &amp;gt; normalizeText&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_core"><mxGeometry x="20" y="398" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_c-cfg" value="&lt;b&gt;config.js&lt;/b&gt;&lt;br&gt;Constants: storage key, month names, default categories.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/core/config.js &amp;gt; STORAGE_KEY&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_core"><mxGeometry x="20" y="539" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_e0" value="bindSync wires it" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_s-run" target="p1_n_u-app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e1" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_u-views" target="p1_n_d-month"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="transact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_u-comp" target="p1_n_d-store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e3" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_d-month" target="p1_n_c-money"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e4" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_d-card" target="p1_n_c-dates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="20" y="1339" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="180" y="1339" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="340" y="1339" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg3" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="500" y="1339" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1373" width="1400" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p2" name="API"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1106" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Components of the API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;backend/src: NestJS modules over ports (interfaces) with Prisma adapters. Controllers only translate HTTP; services hold the behaviour.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1080" height="70" as="geometry"/></mxCell><mxCell id="p2_l_http" value="HTTP layer" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="466" as="geometry"/></mxCell><mxCell id="p2_n_h-main" value="&lt;b&gt;main.ts and create-app.ts&lt;/b&gt;&lt;br&gt;Builds the Fastify app, cookies, body limits, headers on every answer.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/create-app.ts &amp;gt; createApp&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p2_l_http"><mxGeometry x="20" y="56" width="260" height="108" as="geometry"/></mxCell><mxCell id="p2_n_h-guards" value="&lt;b&gt;Global guards, in order&lt;/b&gt;&lt;br&gt;Address rate limit, CSRF, login check, person rate limit, admin, plan feature.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/auth.module.ts &amp;gt; APP_GUARD&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p2_l_http"><mxGeometry x="20" y="184" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_h-input" value="&lt;b&gt;Input checking&lt;/b&gt;&lt;br&gt;Every body and parameter is checked against a schema; 400 names the field.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/http/parse-input.ts &amp;gt; parseInput&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p2_l_http"><mxGeometry x="20" y="325" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_l_mod" value="Feature modules" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="916" as="geometry"/></mxCell><mxCell id="p2_n_m-auth" value="&lt;b&gt;Auth: LoginService, SessionService&lt;/b&gt;&lt;br&gt;Two-step OIDC login; opaque cookie sessions kept as a hash.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/login.service.ts &amp;gt; LoginService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p2_l_mod"><mxGeometry x="20" y="56" width="260" height="137" as="geometry"/></mxCell><mxCell id="p2_n_m-sync" value="&lt;b&gt;Sync: SyncService&lt;/b&gt;&lt;br&gt;Applies pushed mutations once, answers changes after a cursor.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/sync/sync.service.ts &amp;gt; SyncService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p2_l_mod"><mxGeometry x="20" y="213" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_m-acc" value="&lt;b&gt;Accounts: AccountsService&lt;/b&gt;&lt;br&gt;Account rules over the record store.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/accounts/accounts.service.ts &amp;gt; AccountsService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p2_l_mod"><mxGeometry x="20" y="354" width="260" height="107" as="geometry"/></mxCell><mxCell id="p2_n_m-rules" value="&lt;b&gt;Legacy: FinanceRulesService&lt;/b&gt;&lt;br&gt;Runs the shared rules on one person's stored state.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/legacy/finance-rules.service.ts &amp;gt; FinanceRulesService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p2_l_mod"><mxGeometry x="20" y="481" width="260" height="134" as="geometry"/></mxCell><mxCell id="p2_n_m-plans" value="&lt;b&gt;Plans: EntitlementsService&lt;/b&gt;&lt;br&gt;Which features a person's plan has.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/entitlements.service.ts &amp;gt; EntitlementsService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p2_l_mod"><mxGeometry x="20" y="635" width="260" height="120" as="geometry"/></mxCell><mxCell id="p2_n_m-health" value="&lt;b&gt;Health: HealthService&lt;/b&gt;&lt;br&gt;Live always; ready when the database answers.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/health/health.service.ts &amp;gt; HealthService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p2_l_mod"><mxGeometry x="20" y="775" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_l_port" value="Ports and adapters" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="747" as="geometry"/></mxCell><mxCell id="p2_n_p-rec" value="&lt;b&gt;RecordStore&lt;/b&gt;&lt;br&gt;Records with versions, soft delete and a per-person change counter.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/records/record.store.ts &amp;gt; RecordStore&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p2_l_port"><mxGeometry x="20" y="56" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_p-sess" value="&lt;b&gt;SessionRepository&lt;/b&gt;&lt;br&gt;Session rows (only the hash of the cookie value).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/session.repository.ts &amp;gt; SessionRepository&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p2_l_port"><mxGeometry x="20" y="197" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_p-log" value="&lt;b&gt;MutationLog&lt;/b&gt;&lt;br&gt;The answer to every mutation seen, so a retry changes nothing.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/sync/mutation-log.ts &amp;gt; MutationLog&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p2_l_port"><mxGeometry x="20" y="338" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_n_p-plan" value="&lt;b&gt;PlanRepository&lt;/b&gt;&lt;br&gt;Plans and their features.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/plans/plan.repository.ts &amp;gt; PlanRepository&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p2_l_port"><mxGeometry x="20" y="479" width="260" height="107" as="geometry"/></mxCell><mxCell id="p2_n_p-prisma" value="&lt;b&gt;PrismaService&lt;/b&gt;&lt;br&gt;The one database client (pool), connected on first use.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/database/prisma.service.ts &amp;gt; PrismaService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p2_l_port"><mxGeometry x="20" y="606" width="260" height="121" as="geometry"/></mxCell><mxCell id="p2_e0" value="every request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_h-guards" target="p2_n_m-auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e1" value="records outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_m-sync" target="p2_n_p-log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e2" value="reads and writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_m-acc" target="p2_n_p-rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e3" value="sessions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_m-auth" target="p2_n_p-sess"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e4" value="features" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_m-plans" target="p2_n_p-plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_e5" value="ready check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2_n_m-health" target="p2_n_p-prisma"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="1036" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg1" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="180" y="1036" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg2" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="340" y="1036" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1070" width="1080" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
