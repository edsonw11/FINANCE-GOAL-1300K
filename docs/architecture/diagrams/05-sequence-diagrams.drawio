<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Login"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="916" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Sequence of Logging In (OpenID Connect)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Code flow with a one-time login attempt tied to a short cookie; the session cookie holds a random value, the database only its hash.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1260" height="70" as="geometry"/></mxCell><mxCell id="p1_p_br" value="&lt;b&gt;Browser&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p1_p_ac" value="&lt;b&gt;AuthController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="230" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p1_p_ls" value="&lt;b&gt;LoginService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="440" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p1_p_af" value="&lt;b&gt;AuthFlowRepository&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="650" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p1_p_kc" value="&lt;b&gt;Keycloak&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1"><mxGeometry x="860" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p1_p_ss" value="&lt;b&gt;SessionService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="1070" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p1_m0" value="1. GET /auth/login?returnTo" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1271;entryX=0.5;entryY=0.1271;" edge="1" parent="1" source="p1_p_br" target="p1_p_ac"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m1" value="2. begin(returnTo)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1921;entryX=0.5;entryY=0.1921;" edge="1" parent="1" source="p1_p_ac" target="p1_p_ls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m2" value="3. createAuthorizationRequest (state, nonce, PKCE verifier)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.2571;entryX=0.5;entryY=0.2571;strokeColor=#d79b00;" edge="1" parent="1" source="p1_p_ls" target="p1_p_kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m3" value="4. insert the attempt (hashed id), delete expired" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.3220;entryX=0.5;entryY=0.3220;" edge="1" parent="1" source="p1_p_ls" target="p1_p_af"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m4" value="5. 302 to Keycloak, login cookie set" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.3870;entryX=0.5;entryY=0.3870;dashed=1;" edge="1" parent="1" source="p1_p_ac" target="p1_p_br"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m5" value="6. person signs in" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.4520;entryX=0.5;entryY=0.4520;strokeColor=#d79b00;" edge="1" parent="1" source="p1_p_br" target="p1_p_kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m6" value="7. GET /auth/callback?code" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5169;entryX=0.5;entryY=0.5169;" edge="1" parent="1" source="p1_p_br" target="p1_p_ac"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m7" value="8. complete(cookie, callback url)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5819;entryX=0.5;entryY=0.5819;" edge="1" parent="1" source="p1_p_ac" target="p1_p_ls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m8" value="9. consume the attempt (once)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.6469;entryX=0.5;entryY=0.6469;" edge="1" parent="1" source="p1_p_ls" target="p1_p_af"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m9" value="10. completeLogin: exchange the code" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.7119;entryX=0.5;entryY=0.7119;strokeColor=#d79b00;" edge="1" parent="1" source="p1_p_ls" target="p1_p_kc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m10" value="11. create(userId): random token, store its hash" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.7768;entryX=0.5;entryY=0.7768;" edge="1" parent="1" source="p1_p_ls" target="p1_p_ss"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m11" value="12. 302 to returnTo, session cookie set" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.8418;entryX=0.5;entryY=0.8418;dashed=1;" edge="1" parent="1" source="p1_p_ac" target="p1_p_br"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_m12" value="13. LoginFailedError: login cookie cleared, redirect to the login-failed page, no session" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.9068;entryX=0.5;entryY=0.9068;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p1_p_ac" target="p1_p_br"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="828" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="180" y="828" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="340" y="828" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg3" value="External integrations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="1"><mxGeometry x="500" y="828" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="862" width="1260" height="28" as="geometry"/></mxCell><mxCell id="p1_note0" value="Messages 6 and 10 are drawn as external calls. The last message shows the failure path (LoginFailedError)." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="894" width="1260" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p2" name="Sync push and pull"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="898" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p2_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Sequence of a Sync Run&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Every request passes the global guards first. A mutation already seen gets its first answer again and changes nothing.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1260" height="70" as="geometry"/></mxCell><mxCell id="p2_p_br" value="&lt;b&gt;Browser sync runner&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p2_p_gd" value="&lt;b&gt;Global guards&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="230" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p2_p_sc" value="&lt;b&gt;SyncController&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="440" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p2_p_sv" value="&lt;b&gt;SyncService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="650" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p2_p_rs" value="&lt;b&gt;SyncResource (per kind)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="860" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p2_p_db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="1070" y="96" width="150" height="708" as="geometry"/></mxCell><mxCell id="p2_m0" value="1. POST /api/v1/sync/push (cookie, origin, CSRF header)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1271;entryX=0.5;entryY=0.1271;" edge="1" parent="1" source="p2_p_br" target="p2_p_gd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m1" value="2. rate limit, CSRF, login ok" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1921;entryX=0.5;entryY=0.1921;" edge="1" parent="1" source="p2_p_gd" target="p2_p_sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m2" value="3. push(userId, mutations)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.2571;entryX=0.5;entryY=0.2571;" edge="1" parent="1" source="p2_p_sc" target="p2_p_sv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m3" value="4. find the mutation id in the log" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.3220;entryX=0.5;entryY=0.3220;" edge="1" parent="1" source="p2_p_sv" target="p2_p_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m4" value="5. put / remove, if not seen" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.3870;entryX=0.5;entryY=0.3870;" edge="1" parent="1" source="p2_p_sv" target="p2_p_rs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m5" value="6. write the record with a new version" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.4520;entryX=0.5;entryY=0.4520;" edge="1" parent="1" source="p2_p_rs" target="p2_p_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m6" value="7. record the outcome" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5169;entryX=0.5;entryY=0.5169;" edge="1" parent="1" source="p2_p_sv" target="p2_p_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m7" value="8. per mutation: applied, superseded, rejected or skipped" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5819;entryX=0.5;entryY=0.5819;dashed=1;" edge="1" parent="1" source="p2_p_sv" target="p2_p_br"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m8" value="9. GET /api/v1/sync/changes?cursor" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.6469;entryX=0.5;entryY=0.6469;" edge="1" parent="1" source="p2_p_br" target="p2_p_sc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m9" value="10. changes(userId, cursor, limit)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.7119;entryX=0.5;entryY=0.7119;" edge="1" parent="1" source="p2_p_sc" target="p2_p_sv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m10" value="11. changesSince(version) of every resource" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.7768;entryX=0.5;entryY=0.7768;" edge="1" parent="1" source="p2_p_sv" target="p2_p_rs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m11" value="12. changes in version order, new cursor, hasMore" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.8418;entryX=0.5;entryY=0.8418;dashed=1;" edge="1" parent="1" source="p2_p_sv" target="p2_p_br"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_m12" value="13. 401 login / 403 CSRF / 429 too many requests" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.9068;entryX=0.5;entryY=0.9068;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="p2_p_gd" target="p2_p_br"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2_lg0" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="828" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg1" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="180" y="828" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lg2" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="340" y="828" width="150" height="26" as="geometry"/></mxCell><mxCell id="p2_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="862" width="1260" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="p3" name="Monthly report (Pro)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="668" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Sequence of the Monthly Report on the API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;The one route locked behind a plan feature (report.monthly). The rules are the same files the browser uses.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1260" height="70" as="geometry"/></mxCell><mxCell id="p3_p_cl" value="&lt;b&gt;Client&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="20" y="96" width="150" height="478" as="geometry"/></mxCell><mxCell id="p3_p_fg" value="&lt;b&gt;FeatureGuard&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="230" y="96" width="150" height="478" as="geometry"/></mxCell><mxCell id="p3_p_en" value="&lt;b&gt;EntitlementsService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="440" y="96" width="150" height="478" as="geometry"/></mxCell><mxCell id="p3_p_fr" value="&lt;b&gt;FinanceRulesService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="650" y="96" width="150" height="478" as="geometry"/></mxCell><mxCell id="p3_p_ls" value="&lt;b&gt;LegacyStateService&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="860" y="96" width="150" height="478" as="geometry"/></mxCell><mxCell id="p3_p_dr" value="&lt;b&gt;Shared rules (buildReport)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="1070" y="96" width="150" height="478" as="geometry"/></mxCell><mxCell id="p3_m0" value="1. GET /api/v1/months/2026-11/report" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.1883;entryX=0.5;entryY=0.1883;" edge="1" parent="1" source="p3_p_cl" target="p3_p_fg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_m1" value="2. has(userId, report.monthly)?" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.2845;entryX=0.5;entryY=0.2845;" edge="1" parent="1" source="p3_p_fg" target="p3_p_en"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_m2" value="3. plan features read from the database" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.3808;entryX=0.5;entryY=0.3808;dashed=1;" edge="1" parent="1" source="p3_p_en" target="p3_p_fg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3_m3" value="4. 403 feature_locked (the app shows the PRO screen)" style="html=1;verticalAlign=botto