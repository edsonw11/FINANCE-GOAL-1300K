<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Everfox: Rules and Calculations"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="1841" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Rules and Calculations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Everything is a pure rule over the state S (transactions, accounts and balance snapshots, trades, settings). No score or ranking of assets exists in this product.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="p1_l_in" value="Data the rules read" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="610" as="geometry"/></mxCell><mxCell id="p1_n_r-tx" value="&lt;b&gt;Transactions&lt;/b&gt;&lt;br&gt;Income, expense, aporte (money into an investment), card purchases and invoice payments.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/transactions.js &amp;gt; txIn&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_in"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_r-acc" value="&lt;b&gt;Accounts and balances&lt;/b&gt;&lt;br&gt;Each account has dated balance snapshots; a balance on a day comes from them.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/accounts.js &amp;gt; balance&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_in"><mxGeometry x="20" y="198" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_r-trades" value="&lt;b&gt;Trades&lt;/b&gt;&lt;br&gt;Buys and sells read from B3 brokerage notes.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/portfolio.js &amp;gt; tradesOf&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_in"><mxGeometry x="20" y="340" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_r-set" value="&lt;b&gt;Settings&lt;/b&gt;&lt;br&gt;Goal (default 1,300,000), yearly rate (default 12.5%), planned monthly contribution, card days.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/store.js &amp;gt; blankState&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_in"><mxGeometry x="20" y="468" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_l_month" value="Month numbers" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="764" as="geometry"/></mxCell><mxCell id="p1_n_r-sum" value="&lt;b&gt;Month summary&lt;/b&gt;&lt;br&gt;Income, expenses and contributions of a month, with the records behind each number.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/month-summary.js &amp;gt; monthSummary&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_month"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_r-res" value="&lt;b&gt;Month result&lt;/b&gt;&lt;br&gt;left = income - expenses; rate = left / income (none without income); kept = left - invested.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/month-result.js &amp;gt; monthResult&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_month"><mxGeometry x="20" y="211" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_r-lvl" value="&lt;b&gt;Savings level&lt;/b&gt;&lt;br&gt;rate below 0: negative; below 10%: low; 10% to 20%: ok; 20% or more: good.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/savings.js &amp;gt; savingsLevel&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_month"><mxGeometry x="20" y="353" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_r-bud" value="&lt;b&gt;Budget by group&lt;/b&gt;&lt;br&gt;Share of the budget used: up to 80% ok, from 80% near, above 100% over.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/budgets.js &amp;gt; budgetStatus&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_month"><mxGeometry x="20" y="481" width="260" height="108" as="geometry"/></mxCell><mxCell id="p1_n_r-bill" value="&lt;b&gt;Monthly bills&lt;/b&gt;&lt;br&gt;Recurring expenses found in the last 3 months (at least 2 times, amount varying up to 20%).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/monthly-bills.js &amp;gt; monthlyBills&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_month"><mxGeometry x="20" y="609" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_l_card" value="Credit card" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="566" as="geometry"/></mxCell><mxCell id="p1_n_r-cyc" value="&lt;b&gt;Cycle and invoice month&lt;/b&gt;&lt;br&gt;Best purchase day starts the invoice; closing is the day before; due is the next due day after closing; a purchase belongs to the first invoice whose closing has not passed. Weekend closing moves to the next business day if the option is on.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/card-cycle.js &amp;gt; dueMonth&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_card"><mxGeometry x="20" y="56" width="260" height="178" as="geometry"/></mxCell><mxCell id="p1_n_r-inv" value="&lt;b&gt;Invoice items and undetailed amount&lt;/b&gt;&lt;br&gt;Which purchases belong to an invoice, and what the invoice total leaves undetailed.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/card-invoices.js &amp;gt; invoiceUndetailed&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_card"><mxGeometry x="20" y="254" width="260" height="151" as="geometry"/></mxCell><mxCell id="p1_n_r-pay" value="&lt;b&gt;Invoice payment&lt;/b&gt;&lt;br&gt;Plans and records a full or partial payment.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/invoice-payment.js &amp;gt; planPayment&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_card"><mxGeometry x="20" y="425" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_l_wealth" value="Goal and wealth" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="908" width="300" height="821" as="geometry"/></mxCell><mxCell id="p1_n_r-proj" value="&lt;b&gt;Goal projection&lt;/b&gt;&lt;br&gt;monthly rate = (1 + yearly/100)^(1/12) - 1; each month: balance + interest + planned contribution. A second line uses the rate 2 points lower.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/goal-projection.js &amp;gt; projectionPlan&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_wealth"><mxGeometry x="20" y="56" width="260" height="149" as="geometry"/></mxCell><mxCell id="p1_n_r-real" value="&lt;b&gt;Real series and average contribution&lt;/b&gt;&lt;br&gt;Net worth by month from the balances; average of real contributions.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/investments.js &amp;gt; realSeries&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_wealth"><mxGeometry x="20" y="225" width="260" height="124" as="geometry"/></mxCell><mxCell id="p1_n_r-res6" value="&lt;b&gt;Emergency reserve&lt;/b&gt;&lt;br&gt;Reserve balance divided by the average expense of the last 3 closed months; target 6 months, minimum 3.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/emergency-fund.js &amp;gt; emergencyFund&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_wealth"><mxGeometry x="20" y="369" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_r-pos" value="&lt;b&gt;Portfolio positions&lt;/b&gt;&lt;br&gt;Per ticker: quantity, average cost (costs included), amount invested, result of what was sold.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/portfolio.js &amp;gt; positions&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_wealth"><mxGeometry x="20" y="524" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_r-alloc" value="&lt;b&gt;Allocation target&lt;/b&gt;&lt;br&gt;Optional target share per kind of asset; within 2 points of the target counts as on target.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/allocation.js &amp;gt; allocationStatus&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="p1_l_wealth"><mxGeometry x="20" y="666" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_l_imp" value="Import classification" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1190" y="96" width="300" height="408" as="geometry"/></mxCell><mxCell id="p1_n_r-imp" value="&lt;b&gt;What an entry is&lt;/b&gt;&lt;br&gt;Balance line: dropped. Invoice payment, own transfer, refund, redemption, yield or tax: not income or expense on their own. Pix, TED and doc: flagged to confirm. &amp;quot;PARC 03/10&amp;quot;: read as an installment.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/import-classify.js &amp;gt; IMPORT_TYPE&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=30;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="p1_l_imp"><mxGeometry x="20" y="56" width="260" height="177" as="geometry"/></mxCell><mxCell id="p1_n_r-own" value="&lt;b&gt;Own-account transfers&lt;/b&gt;&lt;br&gt;Pairs the two sides of a transfer between the person's accounts, so it is neither income nor expense.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/transfers.js &amp;gt; markTransferPairs&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=30;dashed=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="p1_l_imp"><mxGeometry x="20" y="253" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_e0" value="by month" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_r-tx" target="p1_n_r-sum"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_r-sum" target="p1_n_r-res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_r-res" target="p1_n_r-lvl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e3" value="balances" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_r-acc" target="p1_n_r-real"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e4" value="goal, rate, plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_r-set" target="p1_n_r-proj"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1_n_r-trades" target="p1_n_r-pos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="20" y="1753" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Processing and domain rules" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366" vertex="1" parent="1"><mxGeometry x="180" y="1753" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="Decisions and validations" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656" vertex="1" parent="1"><mxGeometry x="340" y="1753" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1787" width="1400" height="28" as="geometry"/></mxCell><mxCell id="p1_note0" value="Constants are the ones in the code at the time of the build (see the traceability matrix for the line of each)." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1819" width="1400" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
