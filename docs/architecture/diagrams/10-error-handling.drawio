<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p1" name="Everfox: Error Handling"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="1192" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1_title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Everfox: Error Handling&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555555&quot;&gt;Only behaviour found in the code. A failure with no entry here has no specific handling.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="70" as="geometry"/></mxCell><mxCell id="p1_l_dev" value="On the device" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="824" as="geometry"/></mxCell><mxCell id="p1_n_x-save" value="&lt;b&gt;Saving fails (storage full, private mode)&lt;/b&gt;&lt;br&gt;transact() undoes the change and returns false; the person is told, nothing half-saved.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/store.js &amp;gt; transact&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_dev"><mxGeometry x="20" y="56" width="260" height="138" as="geometry"/></mxCell><mxCell id="p1_n_x-read" value="&lt;b&gt;Stored data cannot be read&lt;/b&gt;&lt;br&gt;It is copied to a .broken key, never overwritten; a blank state is used; a notice offers to restore yesterday's copy.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/state-recovery.js &amp;gt; readState&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_dev"><mxGeometry x="20" y="214" width="260" height="136" as="geometry"/></mxCell><mxCell id="p1_n_x-imp" value="&lt;b&gt;Import file too big, wrong type or unreadable&lt;/b&gt;&lt;br&gt;A plain message with the limit; photos and scans are refused; nothing is written.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/domain/import-reader.js &amp;gt; IMPORT_LIMITS&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_dev"><mxGeometry x="20" y="370" width="260" height="151" as="geometry"/></mxCell><mxCell id="p1_n_x-share" value="&lt;b&gt;Backup cannot leave the phone&lt;/b&gt;&lt;br&gt;A cancelled share sheet is not an error and is not counted as a backup; a write failure is told and not counted.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/native-bridge.js &amp;gt; shareTextFile&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_dev"><mxGeometry x="20" y="541" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_x-lock" value="&lt;b&gt;Phone lost its screen lock&lt;/b&gt;&lt;br&gt;The app opens and switches its lock off with a message: no lock-out.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/ui/app-lock/app-lock.js &amp;gt; createAppLock&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="p1_l_dev"><mxGeometry x="20" y="683" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_l_sync" value="Sync (web app)" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="410" y="96" width="300" height="510" as="geometry"/></mxCell><mxCell id="p1_n_x-net" value="&lt;b&gt;Offline, 401 or server error&lt;/b&gt;&lt;br&gt;The api client turns it into offline, unauthorized or server; the outbox stays as it is and the run stops.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/api-client.js &amp;gt; createApiClient&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_sync"><mxGeometry x="20" y="56" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_n_x-rej" value="&lt;b&gt;A mutation is rejected&lt;/b&gt;&lt;br&gt;unknown resource, invalid data or not found: it goes to the review list and the batch stops; later ones are skipped and sent again.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/runner.js &amp;gt; review&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_sync"><mxGeometry x="20" y="198" width="260" height="136" as="geometry"/></mxCell><mxCell id="p1_n_x-none" value="&lt;b&gt;Retries and back-off&lt;/b&gt;&lt;br&gt;No automatic retry loop or back-off timer was found: a run is started by the app, and a failed run leaves the outbox for the next one.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;src/sync/runner.js &amp;gt; createSync&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: NOT IDENTIFIED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="p1_l_sync"><mxGeometry x="20" y="354" width="260" height="136" as="geometry"/></mxCell><mxCell id="p1_l_api" value="On the API" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="800" y="96" width="300" height="1002" as="geometry"/></mxCell><mxCell id="p1_n_x-400" value="&lt;b&gt;400 invalid input&lt;/b&gt;&lt;br&gt;Bodies and parameters are checked against a schema; the answer names the field and the kind of problem.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/http/parse-input.ts &amp;gt; parseInput&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_x-401" value="&lt;b&gt;401 not logged in&lt;/b&gt;&lt;br&gt;Every route needs a login unless marked public; unknown, expired or idle sessions are refused (and idle ones deleted).&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/auth.guard.ts &amp;gt; AuthGuard&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="211" width="260" height="149" as="geometry"/></mxCell><mxCell id="p1_n_x-403" value="&lt;b&gt;403 CSRF, locked feature, not admin&lt;/b&gt;&lt;br&gt;A write must come from the app's own origin with the CSRF header; a locked feature answers code feature_locked.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/csrf.guard.ts &amp;gt; CsrfGuard&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="380" width="260" height="151" as="geometry"/></mxCell><mxCell id="p1_n_x-429" value="&lt;b&gt;429 too many requests&lt;/b&gt;&lt;br&gt;Fixed-window counters in memory, by address and by person; the answer has retryAfterSeconds. Per instance: several instances count separately.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/security/rate-limit.guard.ts &amp;gt; RateLimit&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="551" width="260" height="149" as="geometry"/></mxCell><mxCell id="p1_n_x-413" value="&lt;b&gt;413 body too large&lt;/b&gt;&lt;br&gt;1 MB for every route, 25 MB for the whole-state import.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/create-app.ts &amp;gt; BODY_LIMIT_BYTES&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="720" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_n_x-503" value="&lt;b&gt;503 login unavailable&lt;/b&gt;&lt;br&gt;The identity provider could not be reached to start a login.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/auth/auth.controller.ts &amp;gt; ServiceUnavailableException&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="p1_l_api"><mxGeometry x="20" y="861" width="260" height="121" as="geometry"/></mxCell><mxCell id="p1_l_ops" value="Operation" style="swimlane;startSize=36;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f8f9fb;strokeColor=#9aa4b2;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1190" y="96" width="300" height="508" as="geometry"/></mxCell><mxCell id="p1_n_x-ready" value="&lt;b&gt;Database not ready&lt;/b&gt;&lt;br&gt;/health/ready answers not ready when the database does not answer within the timeout; /health/live stays up.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/health/health.service.ts &amp;gt; HealthService&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_ops"><mxGeometry x="20" y="56" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_x-down" value="&lt;b&gt;Shutdown&lt;/b&gt;&lt;br&gt;SIGTERM or SIGINT closes the server and the pool; after 10 s without finishing it exits with an error.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/shutdown.ts &amp;gt; DEFAULT_SHUTDOWN_TIMEOUT_MS&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_ops"><mxGeometry x="20" y="211" width="260" height="135" as="geometry"/></mxCell><mxCell id="p1_n_x-log" value="&lt;b&gt;Logs&lt;/b&gt;&lt;br&gt;Nest logger with a configurable level; the database URL is logged without its password.&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:9px&quot;&gt;backend/src/config/redact.ts &amp;gt; redact&lt;/font&gt;&lt;br&gt;&lt;i style=&quot;font-size:9px&quot;&gt;Status: IMPLEMENTED&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="p1_l_ops"><mxGeometry x="20" y="366" width="260" height="122" as="geometry"/></mxCell><mxCell id="p1_e0" value="if answered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#4a5568;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1_n_x-net" target="p1_n_x-rej"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1_lg0" value="Errors and attention points" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="1"><mxGeometry x="20" y="1122" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg1" value="Orchestration and services" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6" vertex="1" parent="1"><mxGeometry x="180" y="1122" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg2" value="API and entry" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf" vertex="1" parent="1"><mxGeometry x="340" y="1122" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lg3" value="Infrastructure" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666" vertex="1" parent="1"><mxGeometry x="500" y="1122" width="150" height="26" as="geometry"/></mxCell><mxCell id="p1_lgs" value="Status values: IMPLEMENTED | PARTIAL | NOT CONFIRMED | NOT IDENTIFIED | LEGACY | PROPOSAL | MOCK. Colours are a convention, not an implementation status." style="text;html=1;align=left;whiteSpace=wrap;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1156" width="1400" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
