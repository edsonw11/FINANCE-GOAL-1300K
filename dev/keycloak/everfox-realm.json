{
  "realm": "everfox",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "everfox-web",
      "name": "Everfox (local development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "everfox-dev-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/auth/callback", "http://127.0.0.1:3000/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.test",
      "firstName": "Alice",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice-dev-password", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@example.test",
      "firstName": "Bob",
      "lastName": "Example",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob-dev-password", "temporary": false }]
    }
  ]
}
